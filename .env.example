# =============================================================================
# AutoPaper — environment variables (template)
# =============================================================================
# Copy this file to `.env` in the project root and set your values.
# This repo does not load `.env` automatically; either:
#   - export variables in your shell before running `autopaper`, or
#   - use a tool that injects `.env` (e.g. direnv, your IDE run config).
#
# Never commit `.env` — it is listed in `.gitignore`.

# -----------------------------------------------------------------------------
# Gemini (Google Generative AI)
# -----------------------------------------------------------------------------
# Required when running the full pipeline without `--no-ai`.
# The code checks `GOOGLE_API_KEY` first, then `GEMINI_API_KEY`.
# Get a key: https://aistudio.google.com/apikey

# Optional: override default model (default in code is gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
