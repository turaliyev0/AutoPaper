# LLM keys (pipeline)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# API authentication (OAuth2 password flow → JWT)
# Generate a long random string for production:
AUTOPAPER_JWT_SECRET=change-me-to-a-long-random-secret
AUTOPAPER_JWT_EXPIRE_MINUTES=1440
AUTOPAPER_AUTH_USER=admin
AUTOPAPER_AUTH_PASSWORD=changeme

# Local dev only — skip JWT on all /api routes except /api/auth/*
# AUTOPAPER_AUTH_DISABLED=1

# Optional: multiple users (passwords hashed at startup)
# AUTOPAPER_AUTH_USERS=alice:pass1,bob:pass2

AUTOPAPER_MAX_CONCURRENT_RUNS=2
